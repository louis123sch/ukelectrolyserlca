__pycache__/
*.pyc
.ipynb_checkpoints/
.streamlit/secrets.toml
_streamlit_runs/
.env

# Streamlit agent skills — environment-specific symlinks installed on first run
.agents/skills/developing-with-streamlit
.claude/skills/developing-with-streamlit

# Reproducible API caches — refetched on demand, and neso_green_lcoh.csv alone
# is a 54 MB sensitivity cube. The derived CSVs beside them are kept.
optimisation_outputs/neso_cache/
optimisation_outputs/profile_cache/
optimisation_outputs/renewables_decomposition_cache.json

# Solver outputs — regenerable by scripts/run_dc_scenarios.py, and a 21-scenario
# matrix is ~90 files. VALIDATION.md and notebook 6 carry the results that
# matter, both generated from a run and both tracked.
optimisation_outputs/dc_runs/

# Runtime lock for grid builds — created and removed by sites._build_lock.
optimisation_outputs/.grid_build.lock

# Carbon Intensity API response cache — refetched on demand by notebook 3.1
# during a grid build. Kept on disk, not in git (it was 118 MB).
carbon_intensity_api_cache/
